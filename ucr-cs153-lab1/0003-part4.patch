 #define SYS_close  21
+#define SYS_waitpid  22
diff --git a/sysproc.c b/sysproc.c
index 17fc8d8..f3a958f 100644
--- a/sysproc.c
+++ b/sysproc.c
@@ -33,6 +33,19 @@ sys_wait(void)
   return wait(status);
 }
 
+int
+sys_waitpid(void)
+{
+  int pid, *status, options;
+  if (argint(0, &pid) < 0)
+    return -1;
+  if (argptr(1, (char**)&status, sizeof(int)) < 0)
+    return -1;
+  if (argint(2, &options) < 0)
+    return -1;
+  return waitpid(pid, status, options);
+}
